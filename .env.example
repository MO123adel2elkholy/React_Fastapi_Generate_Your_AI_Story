# API route prefix used by FastAPI.
API_PREFIX=/api
# Debug mode selects local SQLite when running outside Compose.
DEBUG=false
# Leave blank to assemble a PostgreSQL URL from DB_* settings.
DATABASE_URL=
# PostgreSQL username for local Compose.
DB_USER=story_user
# Placeholder only: replace before starting the app.
DB_PASSWORD=replace_with_a_local_password
# Compose overrides this hostname to the PostgreSQL service name.
DB_HOST=localhost
# PostgreSQL port.
DB_PORT=5432
# PostgreSQL database name.
DB_NAME=story_db
# JSON array or comma-separated list of permitted browser origins.
ALLOWED_ORIGINS=[]
# Required OpenAI API key placeholder; replace with your own key.
OPENAI_API_KEY=replace_with_your_key
# Optional OpenAI-compatible base URL; requires OPENAI_API_KEY too.
CHOREO_OPENAI_CONNECTION_SERVICEURL=
